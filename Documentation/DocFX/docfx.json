{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../source",
          "files": [ "**/*.csproj" ],
          "exclude": [ "**/bin/**", "**/obj/**", "ONIONARCH.Tests/**" ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**" ]
      }
    ],
    "resource": [
      {
        "src": "../Images",
        "files": [ "**/*.png", "**/*.jpg", "**/*.svg" ],
        "dest": "images"
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "ONIONARCH.Template",
      "_appTitle": "ONIONARCH.Template",
      "_appFooter": "Generated by DocFX from the XML documentation comments in <a href=\"https://github.com/Vercuski/ONIONARCH.Template\">ONIONARCH.Template</a>.",
      "_enableSearch": true
    }
  }
}

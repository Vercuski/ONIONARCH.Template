@* Applies the application's MudBlazor theme (see MyTheme). *@
<CascadingValue Value=false Name="UsePopoverProvider">
    <MudThemeProvider Theme="MyTheme"></MudThemeProvider>
</CascadingValue>

@code {
    /// <summary>
    /// Gets the application's MudBlazor theme (light and dark palettes share the same primary and
    /// app bar colors). A new instance is created on each access.
    /// </summary>
    public static MudTheme MyTheme => new()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#594AE2",
                AppbarBackground = "#594AE2"
            },
            PaletteDark = new PaletteDark()
            {
                Primary = "#594AE2",
                AppbarBackground = "#594AE2"
            }
        };
}
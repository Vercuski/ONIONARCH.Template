<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for DefaultHttpContext/RequestDelegate (middleware unit tests) and for
         Microsoft.AspNetCore.Mvc.Testing's WebApplicationFactory (integration test). Added
         explicitly rather than relying on it flowing transitively through the Infrastructure/
         Presentation.API project references. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!--#if (HasEfCore) -->
    <!-- In-memory relational engine for the EF Core bulk-operation tests; runs real EFCore.BulkExtensions
         and ExecuteUpdate/ExecuteDelete SQL without a database server. Test-only. Sqlite.Core plus an
         explicit native bundle, because the bundle Microsoft.EntityFrameworkCore.Sqlite 10.0.10 pulls in
         (SQLitePCLRaw 2.1.11) is flagged by GHSA-2m69-gcr7-jv3q, which NU1903 turns into a build error. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- EFCore.BulkExtensions adapter for SQLite, so the entity-list bulk operations run for real in tests. -->
    <PackageReference Include="EFCore.BulkExtensions.Sqlite" Version="10.0.1" />
    <!--#endif -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DomainTests\" />
    <Folder Include="ApplicationTests\" />
    <Folder Include="PresentationTests\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ONIONARCH.Application\ONIONARCH.Application.csproj" />
    <ProjectReference Include="..\ONIONARCH.Domain\ONIONARCH.Domain.csproj" />
    <ProjectReference Include="..\ONIONARCH.Infrastructure\ONIONARCH.Infrastructure.csproj" />
    <ProjectReference Include="..\ONIONARCH.Persistence\ONIONARCH.Persistence.csproj" />
    <!--#if (HasSqlServer) -->
    <ProjectReference Include="..\ONIONARCH.Persistence.SqlServer\ONIONARCH.Persistence.SqlServer.csproj" />
    <!--#endif -->
    <!--#if (HasPostgreSql) -->
    <ProjectReference Include="..\ONIONARCH.Persistence.PostgreSql\ONIONARCH.Persistence.PostgreSql.csproj" />
    <!--#endif -->
    <!--#if (HasMySql) -->
    <ProjectReference Include="..\ONIONARCH.Persistence.MySql\ONIONARCH.Persistence.MySql.csproj" />
    <!--#endif -->
    <!--#if (HasApi) -->
    <ProjectReference Include="..\ONIONARCH.Presentation.API\ONIONARCH.Presentation.API.csproj" />
    <!--#endif -->
    <!--#if (HasWeb) -->
    <ProjectReference Include="..\ONIONARCH.Presentation.Web\ONIONARCH.Presentation.Web.csproj" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

</Project>
